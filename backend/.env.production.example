# ── TimeLogic Backend — PRODUCTION env ───────────────────────────────────────
# NEVER commit real secrets. Generate strong values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

NODE_ENV=production
PORT=10000

# Render PostgreSQL Internal Database URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Hosted Redis URL, for example from Upstash or Render-compatible Redis.
REDIS_URL="rediss://default:PASSWORD@HOST:6379"

# Auth secrets — generate fresh, long, random values (do NOT reuse dev ones)
JWT_ACCESS_SECRET="CHANGE_ME_64_HEX"
JWT_REFRESH_SECRET="CHANGE_ME_DIFFERENT_64_HEX"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# QR signing key — generate fresh
QR_SECRET_KEY="CHANGE_ME_64_HEX"
QR_DEFAULT_ROTATION_SECONDS=30

# Session automation windows (minutes) — defaults match the product spec
CHECKIN_WINDOW_MIN=40
AUTO_CHECKOUT_LAG_MIN=40

# Render persistent disk mount path.
UPLOAD_DIR=/data/uploads
MAX_FILE_SIZE_MB=5

BCRYPT_ROUNDS=12

# Comma-separated deployed frontend origins.
CORS_ORIGINS=https://YOUR-WEB-FRONTEND.example,https://YOUR-PWA-FRONTEND.example

# Optional — email + push. Leave blank to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com
FCM_SERVER_KEY=
