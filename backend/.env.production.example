# ── TimeLogic Backend — PRODUCTION env ───────────────────────────────────────
# Local-first values only. Hosting settings will be added after local testing.
# NEVER commit real secrets. Generate strong values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

NODE_ENV=development
PORT=5000

# Local PostgreSQL from the root compose.yaml file.
DATABASE_URL="postgresql://timelogic:timelogic@localhost:5432/timelogic?schema=public"

# Local Redis from the root compose.yaml file.
REDIS_URL="redis://localhost:6379"

# Auth secrets — generate fresh, long, random values (do NOT reuse dev ones)
JWT_ACCESS_SECRET="CHANGE_ME_64_HEX"
JWT_REFRESH_SECRET="CHANGE_ME_DIFFERENT_64_HEX"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# QR signing key — generate fresh
QR_SECRET_KEY="CHANGE_ME_64_HEX"
QR_DEFAULT_ROTATION_SECONDS=30

# Session automation windows (minutes) — defaults match the product spec
CHECKIN_WINDOW_MIN=40
AUTO_CHECKOUT_LAG_MIN=40

# Local uploaded face photos.
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

BCRYPT_ROUNDS=12

# Local browser clients allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5180

# Optional — email + push. Leave blank to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com
FCM_SERVER_KEY=
